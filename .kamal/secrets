# Secrets referenced here are injected into the container at deploy time.
# This file is gitignored. Back up all values in your password manager.
#
# How to fill these in:
#   RAILS_MASTER_KEY     — already on your machine at config/master.key, line below reads it automatically
#   KAMAL_REGISTRY_PASSWORD — GitHub PAT with packages:write scope (github.com → Settings → Developer settings → PATs)
#   E_ARCA_API_DATABASE_PASSWORD — choose any strong password, use the same value for POSTGRES_PASSWORD
#   POSTGRES_PASSWORD    — same value as E_ARCA_API_DATABASE_PASSWORD

RAILS_MASTER_KEY=$(cat config/master.key)
KAMAL_REGISTRY_PASSWORD=REPLACE_WITH_GITHUB_PAT
E_ARCA_API_DATABASE_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
